# AgriSpectra Enterprise Backend - Environment Configuration Template
# Copy this file to .env and configure your production credentials.

PORT=5050
NODE_ENV=development
ENTERPRISE_API_SECRET=your_enterprise_secret_key_here

# Admin website login credentials (public/landing/admin.html)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here

# Firebase Web / Cloud Project Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
